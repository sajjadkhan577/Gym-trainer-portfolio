Options -Indexes
Options -Multiviews

<FilesMatch "\.(env|log|ini|sh|sql)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(\.git|\.gitignore|composer\.(json|lock)|.*\.(bak|old|orig|dist))$">
    Require all denied
</FilesMatch>

<Files "*.md">
    Require all denied
</Files>

<IfModule mod_php5.c>
    php_flag expose_php Off
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

<IfModule mod_php7.c>
    php_flag expose_php Off
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

<IfModule mod_php.c>
    php_flag expose_php Off
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Custom Error Pages
    ErrorDocument 404 404.php
    ErrorDocument 500 500.php
    ErrorDocument 403 404.php
    ErrorDocument 401 404.php
    
    # Force WWW or non-WWW (choose one)
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ http://%1%{REQUEST_URI} [R=301,L]
    
    # Remove trailing slashes (except for directories)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]
    
    # Protect sensitive directories
    RewriteRule ^(config|database|includes)/ - [F,L]
    RewriteRule ^(?:\.git|\.env)(?:/|$) - [F,L,NC]
    
    # SEO-friendly URLs for pages
    RewriteRule ^about/?$ about.php [L,QSA]
    RewriteRule ^services/?$ services.php [L,QSA]
    RewriteRule ^programs/?$ programs.php [L,QSA]
    RewriteRule ^gallery/?$ gallery.php [L,QSA]
    RewriteRule ^blog/?$ blog.php [L,QSA]
    RewriteRule ^testimonials/?$ testimonials.php [L,QSA]
    RewriteRule ^transformations/?$ transformations.php [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]
    RewriteRule ^book/?$ book.php [L,QSA]
    
    # Blog post URLs with slug
    RewriteRule ^blog/([^/]+)/?$ blog-post.php?slug=$1 [L,QSA]
    
    # Service and program booking
    RewriteRule ^book/service/([0-9]+)/?$ book.php?service=$1 [L,QSA]
    RewriteRule ^book/program/([0-9]+)/?$ book.php?program=$1 [L,QSA]
    
    # Unknown clean URLs should use the custom 404 page instead of the homepage.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ - [R=404,L]
</IfModule>
